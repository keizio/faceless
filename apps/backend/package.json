{
  "name": "@faceless/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,worker -c cyan,magenta \"tsx watch src/index.ts\" \"tsx watch src/worker.ts\"",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^0.1.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@faceless/shared": "workspace:*",
    "@hono/node-server": "^2.0.8",
    "@mastra/core": "^0.10.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tavily/core": "^0.7.6",
    "bullmq": "^5.30.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.0",
    "firebase-admin": "^13.0.0",
    "hono": "^4.7.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "satori": "^0.28.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

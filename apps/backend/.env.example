DATABASE_URL=postgresql://user:password@localhost:5432/faceless
REDIS_URL=redis://localhost:6379
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_SECRET=change-this-to-a-random-secret

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=faceless-media
R2_PUBLIC_URL=https://cdn.solutip.com

OPENROUTER_API_KEY=sk-or-...
DASHSCOPE_API_KEY=sk-...

# AI Models
AI_TEXT_MODEL=qwen-plus
AI_IMAGE_MODEL=wan2.7-image-pro
AI_VIDEO_MODEL=happyhorse-1.1-i2v
AI_AUDIO_MODEL=cosyvoice-v1

# AI Providers (dashscope | openrouter)
AI_TEXT_PROVIDER=dashscope
AI_IMAGE_PROVIDER=dashscope
AI_VIDEO_PROVIDER=dashscope
AI_AUDIO_PROVIDER=dashscope

# DashScope endpoints (optional, defaults to production)
DASHSCOPE_TEXT_URL=https://ws-s9kt82adyyt5wf26.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_IMAGE_URL=https://ws-s9kt82adyyt5wf26.ap-southeast-1.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_VIDEO_URL=https://ws-s9kt82adyyt5wf26.ap-southeast-1.maas.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis
DASHSCOPE_AUDIO_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2audio/audio-synthesis
DASHSCOPE_TASK_URL=https://ws-s9kt82adyyt5wf26.ap-southeast-1.maas.aliyuncs.com/api/v1/tasks/{task_id}
